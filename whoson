#!/usr/bin/env python3
"""Launch whoson using its project environment, from any working directory."""
import os
from pathlib import Path
import sys

root = Path(__file__).resolve().parent
python = root / '.venv' / 'bin' / 'python'
if not python.is_file():
    sys.exit(f'whoson: missing Python environment at {python}. Follow the README setup steps.')
os.execv(str(python), [str(python), str(root / 'main.py'), *sys.argv[1:]])
